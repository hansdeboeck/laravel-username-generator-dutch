{
    "name": "hansdeboeck/laravel-username-generator",
    "description": "Generate a random, kid-safe username.",
    "keywords": [
        "username",
        "username generator"
    ],
    "homepage": "https://github.com/hansdeboeck/laravel-username-generator-dutch",
    "license": "MIT",
    "authors": [
        {
            "name": "Hans De Boeck",
            "email": "hans@deboeck.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "spatie/laravel-package-tools": "^1.92.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-ray": "^1.43"
    },
    "autoload": {
        "psr-4": {
            "HansDeBoeck\\UsernameGenerator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HansDeBoeck\\UsernameGenerator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HansDeBoeck\\UsernameGenerator\\UsernameServiceProvider"
            ],
            "aliases": {
                "Username": "HansDeBoeck\\UsernameGenerator\\Facades\\Username"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
