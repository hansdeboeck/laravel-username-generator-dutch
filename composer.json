{
    "name": "hansdeboeck/laravel-username-generator",
    "description": "Generate a random, kid-safe username.",
    "keywords": [
        "username",
        "username generator"
    ],
    "homepage": "https://github.com/hansdeboeck/laravel-username-generator-dutch",
    "license": "MIT",
    "authors": [
        {
            "name": "Hans De Boeck",
            "email": "hans@deboeck.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4|^9.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.9.2"
    },
    "require-dev": {
        "nunomaduro/collision": "^7.1|^8.1",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "GrantHolle\\UsernameGenerator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GrantHolle\\UsernameGenerator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GrantHolle\\UsernameGenerator\\UsernameServiceProvider"
            ],
            "aliases": {
                "Username": "GrantHolle\\UsernameGenerator\\Facades\\Username"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
